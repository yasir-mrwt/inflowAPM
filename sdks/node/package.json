{
  "name": "@inflowapm/node",
  "version": "0.1.0",
  "description": "Fail-open telemetry client for server-side Node.js applications using InflowAPM.",
  "private": false,
  "license": "MIT",
  "keywords": [
    "apm",
    "express",
    "monitoring",
    "nodejs",
    "observability",
    "telemetry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasir-mrwt/inflowAPM.git",
    "directory": "sdks/node"
  },
  "homepage": "https://github.com/yasir-mrwt/inflowAPM/tree/main/sdks/node#readme",
  "bugs": {
    "url": "https://github.com/yasir-mrwt/inflowAPM/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node ./scripts/finalize-build.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs && npm run test:types && npm run test:imports",
    "test:imports": "node tests/import-esm.mjs && node tests/import-cjs.cjs",
    "test:e2e": "node tests/e2e-real-backend.mjs",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test:open-handles": "node --test tests/open-handles.test.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "benchmark": "node benchmarks/run-request-path.mjs",
    "release:guard": "node scripts/verify-release.mjs",
    "release:check": "npm run lint && npm run typecheck && npm test && npm run test:open-handles && npm run test:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check && npm run release:guard"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.10.0",
    "express": "^5.2.1",
    "express4": "npm:express@4.22.2",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
