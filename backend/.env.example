PORT=5002
NODE_ENV=development

# Use the provider-issued pooled URL with sslmode=require in production.
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/inflowapm_db
TEST_DATABASE_URL=postgresql://postgres:change-me@postgres:5432/inflowapm_test

# Use the provider-issued rediss:// TLS URL in production.
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/1

ACCESS_TOKEN_SECRET=replace-with-a-long-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-refresh-token-secret

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:5002/api/v1/auth/google/callback

SESSION_SECRET=replace-with-a-long-session-secret

MAIL_ENABLED=false
RESEND_API_KEY=re_replace_with_resend_api_key
MAIL_FROM=InflowAPM <noreply@your-domain.com>

ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me
